# =========================================================
# MONOREPO - Frontend + Backend
# =========================================================


# =========================================================
# Frontend - Node / Vue / Vite
# =========================================================

**/node_modules/
**/dist/
**/build/

# Next.js (caso exista)
**/.next/
**/out/

# Vite
**/.vite/

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts


# =========================================================
# Backend - Java / Spring Boot / Maven
# =========================================================

**/target/
**/*.class

# Maven
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/pom.xml.next
**/release.properties

# Gradle
**/.gradle/

# Java crash logs
**/hs_err_pid*
**/replay_pid*


# =========================================================
# Environment variables
# =========================================================

.env
.env.*
!.env.example

**/.env
**/.env.*
!**/.env.example


# =========================================================
# JetBrains / IntelliJ IDEA
# =========================================================

.idea/
**/.idea/

*.iml
**/*.iml
*.ipr
*.iws


# =========================================================
# VS Code
# =========================================================

.vscode/
**/.vscode/

# Permitir configurações compartilháveis
!.vscode/extensions.json
!.vscode/settings.json


# =========================================================
# Docker
# =========================================================

docker-compose.override.yml
**/docker-compose.override.yml


# =========================================================
# Logs / Temporários
# =========================================================

**/*.log
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*.bak


# =========================================================
# Operating System
# =========================================================

.DS_Store
**/.DS_Store

Thumbs.db
**/Thumbs.db

Desktop.ini
**/Desktop.ini